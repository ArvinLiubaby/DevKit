{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevKit",
  "version": "0.1.0",
  "identifier": "com.creek.devkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:14300",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevKit",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "本地优先的开发者效率工具集",
    "longDescription": "DevKit - 本地优先、离线可用、跨平台的开发者效率工具集（JSON 格式化、剪贴板等）。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1", "librsvg2-2"],
        "section": "utils"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMzdDNURBMDA1MkIzRTQKUldUa3MxSUEyc1UzcTFRdGxYY3NKWEtkS003MHlJZ2NOMHhIdzdLZmxpWExzTUcxU2tTWEtmZDkK",
      "endpoints": [
        "https://github.com/{owner}/{repo}/releases/latest/download/latest.json"
      ]
    }
  }
}
